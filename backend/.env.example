# Puerto del servidor (default: 3000)
PORT=3000

# Habilitar endpoints de desarrollo como POST /dev/reset ("true" / "false")
ENABLE_DEV_ENDPOINTS=false

# Autenticación simulada por header x-user-id ("true" / "false")
# IMPORTANTE: Mantener en false. Solo debe activarse para compatibilidad en suites de pruebas automáticas.
ENABLE_SIMULATED_AUTH=false

